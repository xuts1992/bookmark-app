{
  "manifest_version": 3,
  "name": "网页收藏助手",
  "version": "1.0.0",
  "description": "一键收藏当前网页到你的个人书签库",
  "permissions": ["activeTab", "storage", "contextMenus", "notifications", "scripting"],
  "host_permissions": ["http://localhost:9800/*"],
  "action": {
    "default_title": "收藏当前网页 / 打开抽屉",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["site-rules/manifest.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
